generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─── Spectacles ───────────────────────────────────────────────────────────────

model Event {
  id          String      @id @default(cuid())
  title       String      @default("")
  description String?     @db.Text
  imageUrl    String?     @db.Text

  // Fiche artistique
  author    String?
  director  String?
  duration  String?
  genre     String?

  cardTemplate String?     @default("classique")
  featured     Boolean     @default(false)

  status    EventStatus @default(DRAFT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  sessions        Session[]
  priceCategories PriceCategory[]
  castMembers     CastMember[]
  creativeTeam    CreativeTeamMember[]
  bookings        Booking[]
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

model Session {
  id      String @id @default(cuid())
  eventId String
  date    String // "YYYY-MM-DD"
  time    String // "HH:MM"

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model PriceCategory {
  id      String @id @default(cuid())
  eventId String
  name    String
  price   Int    // centimes

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingLines BookingLine[]
}

// Comédiens — rôle joué + nom du comédien
model CastMember {
  id       String  @id @default(cuid())
  eventId  String
  role     String  // personnage / rôle
  name     String  // nom du comédien
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// Équipe créative — fonction + nom (costumes, lumières, son…)
model CreativeTeamMember {
  id       String  @id @default(cuid())
  eventId  String
  role     String  // ex : "Costumes", "Scénographie", "Lumières"
  name     String  // nom de la personne
  artistId String?
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Artistes ──────────────────────────────────────────────────────────────────

model Artist {
  id        String   @id @default(cuid())
  name      String
  category  String?
  bio       String?  @db.Text
  photoUrl  String?  @db.Text
  email     String?
  phone     String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castRoles     CastMember[]
  creativeRoles CreativeTeamMember[]
}

// ─── Ventes & Réservations ────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  eventId     String
  sessionId   String?
  totalAmount Int           // centimes
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())

  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session  Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lines    BookingLine[]
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  REFUNDED
}

model BookingLine {
  id              String @id @default(cuid())
  bookingId       String
  priceCategoryId String
  quantity        Int
  unitPrice       Int    // centimes (snapshot au moment de la réservation)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  priceCategory PriceCategory @relation(fields: [priceCategoryId], references: [id], onDelete: Restrict)
}
